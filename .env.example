# Copy to .env and adjust. Never commit the real .env.
PORT=6767
NODE_ENV=production

# Signing key for sessions. Leave unset to auto-generate a random one in .data/jwt.secret.
# If you set it, use at least 32 random characters (e.g. `openssl rand -base64 48`).
JWT_SECRET=

# Browser origins allowed to call the API / websockets (comma separated). Empty = same-origin only.
ALLOWED_ORIGINS=

# Which reverse proxy may set X-Forwarded-For: "loopback" (default, cloudflared/nginx on this host),
# a hop count like "1", a subnet list, or "false" when the panel is exposed directly.
TRUST_PROXY=loopback

# Content-Security-Policy: enforce (default in production) | report-only | off
CSP_MODE=enforce

# Max size of JSON request bodies.
JSON_BODY_LIMIT=5mb

# SFTP server (per-server file access). Default: all interfaces, port 6868.
SFTP_HOST=0.0.0.0
SFTP_PORT=6868

# Max size of a single-request upload in bytes (default 4 GiB). Larger files use chunked upload.
# MAX_UPLOAD_BYTES=4294967296
