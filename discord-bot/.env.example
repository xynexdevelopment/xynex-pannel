# The bot only needs these two. Everything else (Discord token, server ID, who may use the bot,
# alert/log channels) is entered in the panel:  Admin -> API Keys -> Discord Bot.
PANEL_URL=http://127.0.0.1:6767
PANEL_API_KEY=

# ---- optional ----
# How often (seconds) to check server status for online/offline alerts
POLL_SECONDS=30
# Minimum "loading" animation time (ms) before a card appears. 0 = no delay
LOADING_MS=2000

# ---- legacy fallback (only used if the panel has no value for it) ----
# DISCORD_TOKEN=
# DISCORD_CLIENT_ID=
# GUILD_ID=
# ALLOWED_USER_IDS=
# ALLOWED_ROLE_IDS=
# ADMIN_USER_IDS=
# ADMIN_ROLE_IDS=
# NOTIFY_CHANNEL_ID=
# LOG_CHANNEL_ID=
